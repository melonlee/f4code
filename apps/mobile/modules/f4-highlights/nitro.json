{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["f4highlights"],
  "ios": {
    "iosModuleName": "F4HighlightsNative"
  },
  "android": {
    "androidNamespace": ["f4highlights"],
    "androidCxxLibName": "f4highlights"
  },
  "autolinking": {
    "F4Highlights": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridF4Highlights"
      }
    }
  },
  "ignorePaths": ["node_modules", "Vendor"]
}
